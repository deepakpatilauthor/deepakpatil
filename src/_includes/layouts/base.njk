<!DOCTYPE html>
<html lang="en">
{% include "partials/head.njk" %}
<body class="{% if bodyClass %}{{ bodyClass }}{% else %}font-apple bg-white text-black antialiased{% endif %}">
    {% if nav == "simple" %}
    {% include "partials/header-simple.njk" %}
    {% else %}
    {% include "partials/header.njk" %}
    {% endif %}

    {{ content | safe }}

    {% include "partials/footer.njk" %}

    <script src="/js/main.js"></script>
    <script src="/js/theme.js" defer></script>
    {% if nav != "simple" %}<script src="/js/navbar.js"></script>{% endif %}
    {% if nav != "simple" %}{% include "partials/nav-styles.njk" %}{% endif %}
</body>
</html>
