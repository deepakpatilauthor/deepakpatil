---
layout: layouts/base.njk
activeNav: blog
nav: main
ogType: article
---
<main class="min-h-screen bg-white pt-20">
    <!-- Article Header -->
    <section class="py-20 px-6 pt-24">
        <div class="max-w-4xl mx-auto">
            <!-- Breadcrumb - Fixed -->
            <nav class="mb-8 fixed top-16 left-0 right-0 bg-white/95 backdrop-blur-sm z-50 py-2 px-6 border-b border-gray-100">
                <div class="flex items-center space-x-2 text-sm text-gray-500">
                    <a href="/blog/" class="hover:text-black transition-colors">Blog</a>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                    <span>{{ title }}</span>
                </div>
            </nav>

            <!-- Back to Blog -->
            <a href="/blog/" class="inline-flex items-center text-gray-500 hover:text-black transition-colors mb-8">
                <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
                Back to Blog
            </a>

            <!-- Article Meta -->
            <div class="flex items-center gap-4 mb-6">
                <span class="bg-gray-100 text-gray-700 px-3 py-1 rounded-full text-sm font-medium">{{ category }}</span>
                <span class="text-gray-500 text-sm">{{ date | readableDate }}</span>
                <div class="flex items-center gap-1 text-gray-500 text-sm">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span>{{ readTime }} min read</span>
                </div>
            </div>

            <!-- Article Title -->
            <h1 class="text-5xl md:text-6xl font-apple-display font-bold tracking-tighter mb-8 leading-tight">
                {{ title }}
            </h1>

            <!-- Article Excerpt -->
            <p class="text-xl text-gray-600 leading-relaxed mb-12">
                {{ description }}
            </p>

            <!-- Article Image/Visual -->
            {% if image %}
            <div class="aspect-square bg-gradient-to-br from-blue-100 to-indigo-200 rounded-2xl mb-12 overflow-hidden max-w-2xl mx-auto">
                {% image image, title, "w-full h-full object-cover rounded-2xl", "(min-width: 768px) 672px, 100vw", "eager", "width: 100%; height: 100%; object-fit: cover;" %}
            </div>
            {% endif %}
        </div>
    </section>

    <!-- Article Content -->
    <article class="pb-20 px-6">
        <div class="max-w-4xl mx-auto">
            <div class="prose prose-lg max-w-none">
                {{ content | safe }}
            </div>
        </div>
    </article>
</main>

<!-- Structured Data: BlogPosting (every blog post inherits this) -->
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ title | dump | safe }},
    "description": {{ description | dump | safe }},
    "image": "https://deepakpatil.com{{ image }}",
    "datePublished": "{{ date }}",
    "dateModified": "{{ date }}",
    "author": {
        "@type": "Person",
        "name": "Deepak Patil",
        "url": "https://deepakpatil.com/"
    },
    "publisher": {
        "@type": "Organization",
        "name": "Deepak Patil",
        "logo": {
            "@type": "ImageObject",
            "url": "https://deepakpatil.com/images/og-image.jpg"
        }
    },
    "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://deepakpatil.com{{ page.url }}"
    },
    "url": "https://deepakpatil.com{{ page.url }}",
    "articleSection": {{ category | dump | safe }},
    "timeRequired": "PT{{ readTime }}M",
    "inLanguage": "en",
    "keywords": "DevOps, Cloud Architecture, {{ category }}"
}
</script>

<!-- Structured Data: BreadcrumbList (every blog post inherits this) -->
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://deepakpatil.com/"
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": "Blog",
            "item": "https://deepakpatil.com/blog/"
        },
        {
            "@type": "ListItem",
            "position": 3,
            "name": {{ title | dump | safe }},
            "item": "https://deepakpatil.com{{ page.url }}"
        }
    ]
}
</script>
