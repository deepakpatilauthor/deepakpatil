<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Content Security Policy (meta form: GitHub Pages cannot set HTTP headers).
         'unsafe-inline' is required by the inline theme script + inline styles;
         headers-version should drop it + e.g. 'self'-only if deployed on a
         host that allows HTTP header control (Cloudflare Pages/_headers). -->
    <meta http-equiv="Content-Security-Policy"
          content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests">

    <!-- FOUC prevention: set the theme BEFORE any paint. Checks the saved
         preference first, then falls back to the OS setting. Must stay
         inline + blocking (no external dependency). -->
    <script>
        (function () {
            var theme = null;
            try { theme = localStorage.getItem('theme'); } catch (e) {}
            if (theme !== 'dark' && theme !== 'light') {
                theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            var root = document.documentElement;
            root.setAttribute('data-theme', theme);
            root.style.colorScheme = theme;
        })();
    </script>

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- Primary Meta Tags -->
    <title>{% if title %}{{ title }}{% else %}{{ site.name }}{% endif %}</title>
    {% if ogTitle %}<meta name="title" content="{{ ogTitle }}">{% else %}<meta name="title" content="{% if title %}{{ title }}{% else %}{{ site.name }}{% endif %}">{% endif %}
    <meta name="description" content="{% if description %}{{ description }}{% else %}{{ site.description }}{% endif %}">
    {% if keywords %}<meta name="keywords" content="{{ keywords }}">{% endif %}
    <meta name="author" content="{{ site.author }}">
    <meta name="robots" content="{% if robots %}{{ robots }}{% else %}index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1{% endif %}">
    <meta name="googlebot" content="index, follow">
    <meta name="bingbot" content="index, follow">

    <!-- Canonical URL -->
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">

    <!-- CSS -->
    <link rel="stylesheet" href="/styles/main.css">
    <link rel="stylesheet" href="/styles/tailwind.css">
    <link rel="stylesheet" href="/styles/theme.css">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="{% if ogType %}{{ ogType }}{% else %}website{% endif %}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:title" content="{% if ogTitle %}{{ ogTitle }}{% else %}{% if title %}{{ title }}{% else %}{{ site.name }}{% endif %}{% endif %}">
    <meta property="og:description" content="{% if description %}{{ description }}{% else %}{{ site.description }}{% endif %}">
    <meta property="og:image" content="{{ site.url }}{% if ogImage %}{{ ogImage }}{% else %}{{ site.ogImage }}{% endif %}">
    <meta property="og:image:width" content="{{ site.ogImageWidth }}">
    <meta property="og:image:height" content="{{ site.ogImageHeight }}">
    <meta property="og:image:alt" content="{% if ogImageAlt %}{{ ogImageAlt }}{% else %}{{ site.name }}{% endif %}">
    <meta property="og:site_name" content="{{ site.name }} Portfolio">
    <meta property="og:locale" content="en_US">
    {% if ogType == "article" %}
    <meta property="article:published_time" content="{{ date }}">
    <meta property="article:modified_time" content="{{ date }}">
    <meta property="article:section" content="{{ category }}">
    {% endif %}

    <!-- Twitter -->
    <meta property="twitter:card" content="{% if twitterCard %}{{ twitterCard }}{% else %}summary_large_image{% endif %}">
    <meta property="twitter:url" content="{{ site.url }}{{ page.url }}">
    <meta property="twitter:title" content="{% if ogTitle %}{{ ogTitle }}{% else %}{% if title %}{{ title }}{% else %}{{ site.name }}{% endif %}{% endif %}">
    <meta property="twitter:description" content="{% if description %}{{ description }}{% else %}{{ site.description }}{% endif %}">
    <meta property="twitter:image" content="{{ site.url }}{% if twitterImage %}{{ twitterImage }}{% else %}{% if ogImage %}{{ ogImage }}{% else %}{{ site.ogImage }}{% endif %}{% endif %}">
    <meta property="twitter:creator" content="{{ site.twitter }}">
    <meta property="twitter:site" content="{{ site.twitter }}">

    <!-- Additional SEO Meta Tags -->
    <meta name="theme-color" id="theme-color-meta" content="#0b1120">
    <meta name="msapplication-TileColor" content="#0b1120">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="{{ site.name }}">

    <!-- Preconnect for Performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Fonts (non-render-blocking: preloaded, applied when ready, fallback
         fonts shown until then thanks to &display=swap) -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Manrope:wght@300;400;500;600;700&family=Josefin+Sans:wght@300;400;500;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'">
    <noscript>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Manrope:wght@300;400;500;600;700&family=Josefin+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    </noscript>

    {% if jsonld %}
    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
    {{ jsonld | safe }}
    </script>
    {% endif %}

    <!-- Site-wide WebPage structured data (every page) -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "@id": "{{ site.url }}{{ page.url }}",
        "url": "{{ site.url }}{{ page.url }}",
        "name": {{ (title if title else site.name) | dump | safe }},
        "description": {{ (description if description else site.description) | dump | safe }},
        "isPartOf": {
            "@id": "https://deepakpatil.com/#website"
        },
        "inLanguage": "en",
        "publisher": {
            "@id": "https://deepakpatil.com/#person"
        }
    }
    </script>
</head>
