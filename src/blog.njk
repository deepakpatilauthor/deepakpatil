---
<main class="min-h-screen bg-white">
    <!-- Hero Section -->
    <section class="py-32 px-6 pt-20">
        <div class="max-w-4xl mx-auto text-center">
            <h1 class="text-5xl md:text-6xl font-bold tracking-tight mb-8 text-gray-900">Blog</h1>
            <p class="text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed">
                Insights on engineering, data, and cloud technologies. Simple, reliable, effective.
            </p>
        </div>
    </section>

    <!-- Category Filter -->
    <section class="pb-12 px-6">
        <div class="max-w-7xl mx-auto">
            <div class="max-w-md mx-auto mb-6">
                <div class="relative">
                    <svg class="absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z"></path>
                    </svg>
                    <input
                        id="blog-search"
                        type="search"
                        placeholder="Search articles…"
                        aria-label="Search articles"
                        class="w-full rounded-full border border-gray-300 bg-white py-3 pl-12 pr-4 text-sm focus:outline-none focus:border-gray-900 transition-colors"
                    >
                </div>
            </div>
            <div class="flex flex-wrap gap-3 justify-center">
                <button class="category-btn px-6 py-3 rounded-full text-sm font-medium transition-all duration-300 bg-black text-white" data-category="All">
                    All
                </button>
                <button class="category-btn px-6 py-3 rounded-full text-sm font-medium transition-all duration-300 bg-gray-100 text-gray-700 hover:bg-gray-200" data-category="DevOps & Cloud">
                    DevOps & Cloud
                </button>
                <button class="category-btn px-6 py-3 rounded-full text-sm font-medium transition-all duration-300 bg-gray-100 text-gray-700 hover:bg-gray-200" data-category="User Experience">
                    User Experience
                </button>
                <button class="category-btn px-6 py-3 rounded-full text-sm font-medium transition-all duration-300 bg-gray-100 text-gray-700 hover:bg-gray-200" data-category="Development">
                    Development
                </button>
            </div>
        </div>
    </section>

    <!-- Blog Posts Grid -->
    <section class="pb-32 px-6">
        <div class="max-w-6xl mx-auto">
            <div id="blog-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                {% for post in collections.postsSorted | limit(6) %}
                    <article class="blog-post group cursor-pointer" data-category="{{ post.data.category }}" onclick="window.location.href='{{ post.url }}'">
                        <div class="bg-white rounded-lg overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 group-hover:-translate-y-1">
                            <div class="aspect-square overflow-hidden">
                                {% if post.data.image %}
                                {% image post.data.image, post.data.cardTitle, "w-full h-full object-cover group-hover:scale-105 transition-transform duration-300", "(min-width: 1024px) 370px, (min-width: 768px) 350px, 100vw" %}
                                {% else %}
                                <div class="w-full h-full bg-gradient-to-br from-green-100 to-emerald-200 flex items-center justify-center">
                                    <div class="text-center p-8">
                                        <div class="w-16 h-16 mx-auto mb-4 bg-green-600 rounded-full flex items-center justify-center">
                                            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m-4 4l4 4-4 4m6-4h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v-2h2v-6h-2v-2z"></path>
                                            </svg>
                                        </div>
                                        <h4 class="text-lg font-bold text-gray-800 mb-2">Linux Commands</h4>
                                        <p class="text-gray-600 text-sm">Complete Reference Guide</p>
                                    </div>
                                </div>
                                {% endif %}
                            </div>
                            <div class="p-6">
                                <div class="flex items-center gap-3 mb-4">
                                    <span class="bg-gray-100 text-gray-700 px-3 py-1 rounded-full text-sm font-medium">
                                        {{ post.data.category }}
                                    </span>
                                </div>
                                <h3 class="text-xl font-bold mb-4 group-hover:text-blue-600 transition-colors leading-tight text-gray-900">
                                    {{ post.data.cardTitle }}
                                </h3>
                                <p class="text-gray-600 leading-relaxed mb-6">{{ post.data.excerpt }}</p>
                                <div class="flex items-center gap-4 text-sm text-gray-500">
                                    <div class="flex items-center gap-1">
                                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                        </svg>
                                        <span>{{ post.date | readableDate }}</span>
                                    </div>
                                    <div class="flex items-center gap-1">
                                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                        </svg>
                                        <span>{{ post.data.readTime }} min read</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </article>
                {% endfor %}
            </div>
            <div class="flex justify-center mt-12">
                {% if collections.postsSorted.length > 6 %}
                <button
                    id="load-more-btn"
                    type="button"
                    class="inline-flex items-center gap-2 px-8 py-4 rounded-full text-sm font-medium bg-gray-900 text-white hover:bg-gray-800 transition-colors duration-200"
                >
                    Load More
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                </button>
                {% endif %}
            </div>
        </div>
    </section>

    <!-- Newsletter Section -->
    <section class="py-32 px-6 bg-gray-50">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-4xl md:text-5xl font-bold tracking-tight mb-8 text-gray-900">Stay Updated</h2>
            <p class="text-xl text-gray-600 mb-12 max-w-2xl mx-auto">
                Get notified when I publish new articles about engineering, data, and cloud technologies.
            </p>
            <div class="max-w-md mx-auto">
                <form class="newsletter-form flex gap-4">
                    <input
                        type="email"
                        placeholder="Enter your email"
                        class="flex-1 px-6 py-4 rounded-lg border border-gray-300 focus:outline-none focus:border-gray-900 transition-colors"
                        required
                    />
                    <button type="submit" class="btn btn-primary bg-gray-900 text-white hover:bg-gray-800 rounded-lg px-8 py-4">
                        Subscribe
                    </button>
                </form>
            </div>
        </div>
    </section>
</main>

<style>
    /* Mobile responsiveness improvements for blog page */
    @media (max-width: 768px) {
        .hero-title {
            font-size: clamp(2.5rem, 8vw, 4rem);
            line-height: 1.1;
        }

        .hero-subtitle {
            font-size: clamp(1.125rem, 4vw, 1.5rem);
            line-height: 1.5;
        }

        .blog-grid {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        .featured-article .grid {
            grid-template-columns: 1fr;
        }

        .featured-article .aspect-\[4\/3\] {
            aspect-ratio: 16/9;
        }

        .category-buttons {
            flex-wrap: wrap;
            gap: 0.75rem;
            justify-content: center;
        }

        .category-btn {
            padding: 0.75rem 1.5rem;
            font-size: 0.875rem;
        }

        .newsletter-form {
            flex-direction: column;
            gap: 1rem;
        }

        .newsletter-form input {
            width: 100%;
        }

        .newsletter-form button {
            width: 100%;
        }
    }

    @media (max-width: 480px) {
        .hero-title {
            font-size: clamp(2rem, 7vw, 3rem);
        }

        .hero-subtitle {
            font-size: clamp(1rem, 4vw, 1.25rem);
        }

        .px-6 {
            padding-left: 1rem;
            padding-right: 1rem;
        }

        .py-32 {
            padding-top: 4rem;
            padding-bottom: 4rem;
        }

        .blog-post {
            margin-bottom: 1.5rem;
        }

        .blog-post .p-6 {
            padding: 1rem;
        }

        .category-btn {
            padding: 0.5rem 1rem;
            font-size: 0.8rem;
        }
    }

    @media (hover: none) and (pointer: coarse) {
        .hover\:bg-gray-100:hover {
            background-color: transparent;
        }

        .hover\:bg-gray-100:active {
            background-color: rgb(243 244 246);
        }

        .hover\:scale-105:hover {
            transform: none;
        }

        .hover\:scale-105:active {
            transform: scale(1.02);
        }
    }

    html, body {
        overflow-x: hidden;
        max-width: 100%;
    }

    * {
        max-width: 100%;
        box-sizing: border-box;
    }

    p, span, div, h1, h2, h3, h4, h5, h6 {
        word-break: break-word;
    }
</style>
